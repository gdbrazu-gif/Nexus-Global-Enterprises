    // =========================================================================
    // 9. Settings, Template Configs, RBAC & Custom Privileges
    // =========================================================================
    function isValidCorporateSettings(data, settingId) {
      return data.keys().hasAll(['id', 'serverUpdatedAt'])
        && data.id == settingId
        && data.keys().hasOnly([
          'id', 'companyName', 'legalName', 'logoUrl', 'crNumber', 'vatNumber',
          'email', 'phone', 'address', 'bankName', 'accountTitle', 'iban', 'swiftCode',
          'baseCurrency', 'customVillaTypes', 'manpowerTrades', 'inventoryCategories',
          'inventoryUOMs', 'inventoryWarehouses', 'updatedByUid', 'serverUpdatedAt'
        ])
        && isOptStr(data, 'companyName', 160)
        && isOptStr(data, 'legalName', 200)
        && isOptStr(data, 'logoUrl', 65536)
        && isOptStr(data, 'crNumber', 64)
        && isOptStr(data, 'vatNumber', 64)
        && isOptStr(data, 'email', 120)
        && isOptStr(data, 'phone', 40)
        && isOptStr(data, 'address', 300)
        && isOptStr(data, 'bankName', 120)
        && isOptStr(data, 'accountTitle', 160)
        && isOptStr(data, 'iban', 64)
        && isOptStr(data, 'swiftCode', 32)
        && isOptStr(data, 'baseCurrency', 16)
        && isOptStringList(data, 'customVillaTypes', 200)
        && isOptStringList(data, 'manpowerTrades', 200)
        && isOptStringList(data, 'inventoryCategories', 200)
        && isOptStringList(data, 'inventoryUOMs', 200)
        && isOptStringList(data, 'inventoryWarehouses', 200)
        && isValidUpdatedBy(data)
        && data.serverUpdatedAt == request.time;
    }

    match /corporate_settings/{settingId} {
      allow get: if isValidId(settingId) && isWorkspaceMember();
      allow list: if isWorkspaceMember();
      allow create: if isValidId(settingId) && isAdmin()
        && isValidCorporateSettings(request.resource.data, settingId);
      allow update: if isValidId(settingId)
        && isValidCorporateSettings(request.resource.data, settingId)
        && (
          isAdmin()
          || (isManagerOrHr()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'customVillaTypes', 'manpowerTrades', 'inventoryCategories', 'inventoryUOMs',
              'inventoryWarehouses', 'updatedByUid', 'serverUpdatedAt'
            ]))
        );
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /template_configs/{templateId} {
      allow get: if isValidId(templateId) && isWorkspaceMember();
      allow list: if isWorkspaceMember();
      allow create, update: if isValidId(templateId) && isManagerOrHr()
        && request.resource.data.keys().hasAll(['id', 'title', 'serverUpdatedAt'])
        && request.resource.data.id == templateId
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'subtitle', 'showLogo', 'logoPosition', 'accentColor',
          'showWatermark', 'watermarkText', 'showLegalEntity', 'showSignatures',
          'showQrStamp', 'footerNote', 'letterheadHeaderStyle', 'headerCompanyName',
          'headerLegalName', 'headerCrNumber', 'headerVatNumber', 'headerAddress',
          'headerPhone', 'headerEmail', 'headerWebsite', 'customLogoUrl',
          'showContactFooterBar', 'refNumber', 'documentDate', 'showRecipientBlock',
          'recipientName', 'recipientTitle', 'recipientOrganization', 'subjectLine',
          'bodyContent', 'signatoryName', 'signatoryTitle', 'recipientSignatoryLabel',
          'updatedByUid', 'serverUpdatedAt'
        ])
        && isNonEmptyStr(request.resource.data.title, 160)
        && isOptStr(request.resource.data, 'customLogoUrl', 65536)
        && isOptStr(request.resource.data, 'bodyContent', 20000)
        && isValidUpdatedBy(request.resource.data)
        && request.resource.data.serverUpdatedAt == request.time;
      allow delete: if isValidId(templateId) && isAdmin();
    }

    match /custom_privileges/{privId} {
      allow get: if isValidId(privId) && isWorkspaceMember();
      allow list: if isWorkspaceMember();
      allow create, update: if isValidId(privId) && isAdmin()
        && isValidGenericRecord(request.resource.data, privId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'description', 'assignedUsersCount', 'permissions', 'updatedByUid', 'serverUpdatedAt'])
        && isOptStr(request.resource.data, 'name', 120)
        && isOptStr(request.resource.data, 'description', 500)
        && isOptNum(request.resource.data, 'assignedUsersCount', 0)
        && (!('permissions' in request.resource.data)
          || (request.resource.data.permissions is map && request.resource.data.permissions.keys().size() <= 32));
      allow delete: if isValidId(privId) && isAdmin();
    }

    match /rbac_matrix/{roleId} {
      allow get: if isValidId(roleId) && isWorkspaceMember();
      allow list: if isWorkspaceMember();
      allow create, update: if isValidId(roleId) && isAdmin()
        && request.resource.data.keys().hasAll(['roleId', 'permissions', 'serverUpdatedAt'])
        && request.resource.data.keys().hasOnly(['roleId', 'permissions', 'updatedAt', 'updatedByUid', 'serverUpdatedAt'])
        && request.resource.data.roleId == roleId
        && request.resource.data.roleId in ['super_admin', 'branch_admin', 'hr_manager', 'finance_officer', 'project_manager', 'employee']
        && request.resource.data.permissions is map
        && request.resource.data.permissions.keys().size() <= 250
        && isOptStr(request.resource.data, 'updatedAt', 64)
        && isValidUpdatedBy(request.resource.data)
        && request.resource.data.serverUpdatedAt == request.time;
      allow delete: if isValidId(roleId) && isAdmin();
    }

    // =========================================================================
    // 10. Tamper-Evident Append-Only Audit Logs (/audit_logs/{logId})
    // =========================================================================
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAuditReader();
      allow list: if isAuditReader();
      allow create: if isValidId(logId)
        && isWorkspaceMember()
        && request.resource.data.keys().hasAll(['id', 'timestamp', 'operatorName', 'operatorRole', 'operatorUid', 'actionType', 'entityType', 'details', 'serverCreatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'timestamp', 'operatorName', 'operatorRole', 'operatorUid', 'branchId', 'actionType', 'entityType', 'details', 'serverCreatedAt'])
        && request.resource.data.id == logId
        && isNonEmptyStr(request.resource.data.timestamp, 64)
        && isNonEmptyStr(request.resource.data.operatorName, 100)
        && isNonEmptyStr(request.resource.data.operatorRole, 64)
        && isNonEmptyStr(request.resource.data.actionType, 32)
        && isNonEmptyStr(request.resource.data.entityType, 32)
        && isNonEmptyStr(request.resource.data.details, 500)
        && request.resource.data.operatorUid == request.auth.uid
        && isOptStr(request.resource.data, 'branchId', 64)
        && request.resource.data.serverCreatedAt == request.time;
      allow update, delete: if false;
    }

    // =========================================================================
    // 11. Authentication Code Challenges (/auth_challenges/{userId})
    // =========================================================================
    function isValidAuthChallenge(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'codeHash', 'expiresAt', 'verified', 'serverUpdatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'codeHash', 'expiresAt', 'verified', 'sentAt',
          'updatedByUid', 'serverUpdatedAt'
        ])
        && data.uid == userId
        && isNonEmptyStr(data.email, 120)
        && data.email.lower() == normalizedEmail()
        && isNonEmptyStr(data.codeHash, 128)
        && (data.expiresAt is int || data.expiresAt is number)
        && data.expiresAt > 0
        && data.verified is bool
        && isOptStr(data, 'sentAt', 64)
        && isValidUpdatedBy(data)
        && data.serverUpdatedAt == request.time;
    }

    match /auth_challenges/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && isWorkspaceMember();
      allow list: if false;
      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isWorkspaceMember()
        && isValidAuthChallenge(request.resource.data, userId);
      allow delete: if isValidId(userId) && isOwner(userId) && isWorkspaceMember();
    }
  }
}
